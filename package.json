{
  "name": "deepam-textile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:hostinger": "RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=1 NODE_OPTIONS='--max-old-space-size=768' NEXT_TELEMETRY_DISABLED=1 npm run build && npm run postbuild",
    "setup:hostinger-static": "bash scripts/setup-hostinger-static.sh",
    "setup:hostinger-uploads": "bash scripts/setup-hostinger-uploads.sh",
    "postbuild": "mkdir -p .next/standalone/.next && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "package:deploy": "bash scripts/package-standalone.sh",
    "verify:deploy": "bash scripts/verify-deploy.sh",
    "health-check:uploads": "bash scripts/health-check-uploads.sh",
    "start": "next start -p ${PORT:-3000}",
    "start:standalone": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "backfill:product-cards": "tsx scripts/backfill-product-card-images.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.5",
    "jose": "^6.1.0",
    "lucide-react": "^0.554.0",
    "next": "^15.5.26",
    "postcss": "^8.5.3",
    "prisma": "^6.16.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.30.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "zod": "^3.25.76"
  }
}
